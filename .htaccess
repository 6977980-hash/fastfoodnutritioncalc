# This folder is only loaded by WordPress through PHP. Browsers never need
# any file here (live theme assets are served from the theme folder), so
# block direct requests to README.md, readme.txt, theme/, scripts/, etc.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order deny,allow
	Deny from all
</IfModule>
